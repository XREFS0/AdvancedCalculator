<Window x:Class="AdvancedCalculator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AdvancedCalculator.UI.ViewModels"
        xmlns:views="clr-namespace:AdvancedCalculator.UI.Views"
        mc:Ignorable="d"
        Title="Advanced Calculator Pro"
        Height="720" Width="820"
        MinHeight="600" MinWidth="680"
        Background="{DynamicResource BackgroundBrush}"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyDown="MainWindow_OnKeyDown">

    <Window.Resources>
        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type viewModels:StandardCalculatorViewModel}">
            <views:StandardCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ScientificCalculatorViewModel}">
            <views:ScientificCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProgrammerCalculatorViewModel}">
            <views:ProgrammerCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UnitConverterViewModel}">
            <views:UnitConverterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CurrencyConverterViewModel}">
            <views:CurrencyConverterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- App Brand Header -->
                    <RowDefinition Height="*" />     <!-- Nav items -->
                    <RowDefinition Height="Auto" />  <!-- Footer items (Settings / Topmost) -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="8,0,8,20">
                    <TextBlock Text="Calculator Pro" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Advanced &amp; Modern" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="Standard" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Standard" IsChecked="True" />
                    <RadioButton Content="Scientific" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Scientific" />
                    <RadioButton Content="Programmer" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Programmer" />
                    <RadioButton Content="Unit Converter" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="UnitConverter" />
                    <RadioButton Content="Currency" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="CurrencyConverter" />
                    <RadioButton Content="History" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="History" />
                </StackPanel>

                <!-- Footer Menu -->
                <StackPanel Grid.Row="2">
                    <Separator Background="{DynamicResource DividerBrush}" Margin="6,10" />
                    <RadioButton Content="Settings" Style="{DynamicResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active View Content -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
